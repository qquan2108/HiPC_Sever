                <div class="p-3 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl">
                    <i class="fas fa-industry text-white text-xl"></i>
                </div>
                <h1 class="text-3xl font-bold bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">
                    Quản lý Thương hiệu
                </h1>
            </div>
        </div>
    </header>


{{!-- Add Brand (trigger) --}}
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-8">
  <div class="flex items-center justify-between">
    <div class="flex items-center">
      <i class="fas fa-plus-circle text-hipc-blue text-xl mr-3"></i>
      <h3 class="text-lg font-semibold text-hipc-dark">Thêm thương hiệu mới</h3>
    </div>
    <button
  id="openAddBrandModalBtn"
  type="button"
  class="bg-blue-500 hover:bg-blue-600 text-white font-medium px-4 py-2 rounded-lg transition-all duration-200"
>
  <i class="fas fa-plus mr-2"></i>Thêm thương hiệu
</button>

  </div>
</div>

<div class="mb-8">
    <div class="flex items-center space-x-2 text-sm text-hipc-gray">
      <i class="fas fa-tags"></i>
      <span id="brandCount">{{#if brands}}{{brands.length}}{{else}}0{{/if}} thương hiệu</span>
    </div>
</div>

{{!-- Search and Filter --}}
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 mb-6">
  <div class="flex flex-col sm:flex-row gap-4">
    <div class="flex-1">
      <div class="relative">
        <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-hipc-gray"></i>
        <input
          type="text"
          id="searchInput"
          placeholder="Tìm kiếm thương hiệu..."
          class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-hipc-blue focus:border-transparent"
        >
      </div>
    </div>
    <button
      id="refreshBtn"
      class="px-4 py-2 text-hipc-blue hover:bg-hipc-blue hover:text-white border border-hipc-blue rounded-lg transition-all duration-200"
    >
      <i class="fas fa-sync-alt mr-2"></i>
      Làm mới
    </button>
  </div>
</div>

<div class="tabs mb-6">
  <a href="/admin/brand?view=active" class="px-4 py-2 bg-blue-500 text-white rounded mr-2">Đang hoạt động</a>
  <a href="/admin/brand?view=all" class="px-4 py-2 bg-blue-500 text-white rounded mr-2">Tất cả</a>
  <a href="/admin/brand?view=trash" class="px-4 py-2 bg-blue-500 text-white rounded">Thùng rác</a>
</div>

{{!-- Brands Table --}}
<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-200">
    <h3 class="text-lg font-semibold text-hipc-dark flex items-center">
      <i class="fas fa-list mr-3"></i>
      Danh sách thương hiệu
    </h3>
  </div>

  <div class="overflow-x-auto {{#unless brands.length}}hidden{{/unless}}" id="tableWrapper">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-hipc-gray uppercase tracking-wider">
            <i class="fas fa-tag mr-2"></i>Thương hiệu
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-hipc-gray uppercase tracking-wider">
            <i class="fas fa-image mr-2"></i>Logo
          </th>
          <th class="px-6 py-3 text-center text-xs font-medium text-hipc-gray uppercase tracking-wider">
            <i class="fas fa-cog mr-2"></i>Thao tác
          </th>
        </tr>
      </thead>
      <tbody id="brandsTable" class="bg-white divide-y divide-gray-200">
        {{#each brands}}
          <tr class="hover:bg-gray-50 transition-colors duration-150" data-id="{{_id}}">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm font-medium text-hipc-dark">{{name}}</div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              {{#if logo}}
                <img src="{{logo}}" alt="{{name}}" class="h-10 w-auto object-contain rounded border" onerror="this.style.display='none'">
              {{else}}
                <span class="text-gray-400 text-sm">Không có logo</span>
              {{/if}}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-center">
              <div class="flex items-center justify-center space-x-3">
                <button
                  class="btn-edit text-hipc-blue hover:text-blue-700 transition-colors duration-150"
                  title="Sửa"
                  data-id="{{_id}}"
                  data-name="{{name}}"
                  data-logo="{{logo}}"
                >
                  <i class="fas fa-edit text-lg"></i>
                </button>
                <button
                  class="btn-delete text-red-500 hover:text-red-700 transition-colors duration-150"
                  title="Xóa"
                  data-id="{{_id}}"
                  data-name="{{name}}"
                >
                  <i class="fas fa-trash text-lg"></i>
                </button>
              </div>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  {{!-- Empty State --}}
  <div id="emptyState" class="text-center py-12 {{#if brands.length}}hidden{{/if}}">
    <i class="fas fa-tags text-gray-300 text-4xl mb-4"></i>
    <h3 class="text-lg font-medium text-gray-900 mb-2">Chưa có thương hiệu nào</h3>
    <p class="text-gray-500 mb-4">Thêm thương hiệu đầu tiên để bắt đầu quản lý</p>
  </div>

  {{!-- Loading State (ẩn mặc định, dùng khi gọi API) --}}
  <div id="loadingState" class="text-center py-12 hidden">
    <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-hipc-blue"></div>
    <p class="mt-2 text-hipc-gray">Đang tải...</p>
  </div>
</div>

{{!-- Toast Notification --}}
<div id="toast" class="fixed top-4 right-4 z-50 hidden">
  <div class="bg-white border border-gray-200 rounded-lg shadow-lg p-4 max-w-sm">
    <div class="flex items-center">
      <div id="toastIcon" class="flex-shrink-0 mr-3"></div>
      <div id="toastMessage" class="text-sm font-medium"></div>
    </div>
  </div>
</div>

{{!-- Dữ liệu JSON từ server để JS sử dụng (tránh cần helper json) --}}
<script>
  const currentView = '{{view}}';
  // ===== Toast =====
  function showToast(message, type = 'success') {
    const toast = document.getElementById('toast');
    const toastIcon = document.getElementById('toastIcon');
    const toastMessage = document.getElementById('toastMessage');
    const icons = {
      success: '<i class="fas fa-check-circle text-green-500"></i>',
      error:   '<i class="fas fa-exclamation-circle text-red-500"></i>',
      info:    '<i class="fas fa-info-circle text-blue-500"></i>'
    };
    toastIcon.innerHTML = icons[type] || icons.info;
    toastMessage.textContent = message;
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 3000);
  }

  function updateBrandCount() {
    const rows = document.querySelectorAll('#brandsTable tr');
    document.getElementById('brandCount').textContent = rows.length + ' thương hiệu';
  }

  function toggleEmptyTable(hasRows) {
    document.getElementById('tableWrapper').classList.toggle('hidden', !hasRows);
    document.getElementById('emptyState').classList.toggle('hidden', hasRows);
  }

  // ===== Render =====
  function renderTable(brands = []) {
    const tbody = document.getElementById('brandsTable');
    tbody.innerHTML = '';
    brands.forEach(b => {
      const tr = document.createElement('tr');
      tr.className = 'hover:bg-gray-50 transition-colors duration-150';
      tr.dataset.id = b._id;
      if (b.isDeleted) {
        tr.style.opacity = '0.5';
        tr.style.textDecoration = 'line-through';
      }
      tr.innerHTML = `
        <td class="px-6 py-4 whitespace-nowrap">
          <div class="text-sm font-medium text-hipc-dark">${b.name}</div>
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          ${b.logo
            ? `<img src="${b.logo}" alt="${b.name}" class="h-10 w-auto object-contain rounded border" onerror="this.style.display='none'">`
            : `<span class="text-gray-400 text-sm">Không có logo</span>`}
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-center">
          <div class="flex items-center justify-center space-x-3">
            ${b.isDeleted ? `
              <button class="btn-restore text-hipc-blue hover:text-blue-700 transition-colors duration-150" title="Khôi phục" data-id="${b._id}">
                <i class="fas fa-undo text-lg"></i>
              </button>
              <button class="btn-purge text-red-500 hover:text-red-700 transition-colors duration-150" title="Xóa vĩnh viễn" data-id="${b._id}">
                <i class="fas fa-trash text-lg"></i>
              </button>
            ` : `
              <button class="btn-edit text-hipc-blue hover:text-blue-700 transition-colors duration-150" title="Sửa" data-id="${b._id}" data-name="${b.name}" data-logo="${b.logo || ''}">
                <i class="fas fa-edit text-lg"></i>
              </button>
              <button class="btn-delete text-red-500 hover:text-red-700 transition-colors duration-150" title="Xóa" data-id="${b._id}" data-name="${b.name}">
                <i class="fas fa-trash text-lg"></i>
              </button>
            `}
          </div>
        </td>
      `;
      tbody.appendChild(tr);
    });
    toggleEmptyTable(brands.length > 0);
    updateBrandCount();
  }

  // ===== API base =====
  const API_BASE = '/brands';

  async function fetchJSON(url, options = {}) {
    const res = await fetch(url, {
      headers: { 'Content-Type': 'application/json' },
      ...options
    });
    if (!res.ok) {
      const msg = await res.text().catch(() => '');
      throw new Error(msg || `HTTP ${res.status}`);
    }
    // No content
    if (res.status === 204) return null;
    return res.json();
  }

  // ===== CRUD via API =====
  async function apiListBrands() {
    return fetchJSON(`${API_BASE}?view=${currentView}`, { method: 'GET' });
  }

  async function apiCreateBrand(payload) {
    return fetchJSON(API_BASE, {
      method: 'POST',
      body: JSON.stringify(payload)
    });
  }

  async function apiUpdateBrand(id, payload) {
    return fetchJSON(`${API_BASE}/${id}`, {
      method: 'PUT',
      body: JSON.stringify(payload)
    });
  }

  async function apiDeleteBrand(id) {
    return fetchJSON(`${API_BASE}/${id}`, { method: 'DELETE' });
  }

  async function apiRestoreBrand(id) {
    return fetchJSON(`${API_BASE}/${id}/restore`, { method: 'POST' });
  }

  async function apiPurgeBrand(id) {
    return fetchJSON(`${API_BASE}/${id}/purge`, { method: 'DELETE' });
  }

  // ===== Page behaviors =====
  let currentBrands = [];

  async function loadAndRender() {
    const loading = document.getElementById('loadingState');
    const empty = document.getElementById('emptyState');
    loading.classList.remove('hidden');
    empty.classList.add('hidden');
    try {
      currentBrands = await apiListBrands();  // GET /brands
      renderTable(currentBrands);
    } catch (err) {
      console.error(err);
      showToast('Không tải được danh sách thương hiệu', 'error');
      renderTable([]);
    } finally {
      loading.classList.add('hidden');
    }
  }

  // ===== init =====
  document.addEventListener('DOMContentLoaded', () => {
    // 1) Load lần đầu từ API
    loadAndRender();

    // 2) Tạo mới
    {{!-- document.getElementById('createForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('brandName').value.trim();
      const logo = document.getElementById('brandLogo').value.trim();
      if (!name) { showToast('Vui lòng nhập tên thương hiệu', 'error'); return; }
      if (currentBrands.find(b => b.name.toLowerCase() === name.toLowerCase())) {
        showToast('Thương hiệu đã tồn tại', 'error'); return;
      }
      try {
        await apiCreateBrand({ name, logo: logo || null });   // POST /brands
        await loadAndRender();
        e.target.reset();
        showToast('Thêm thương hiệu thành công', 'success');
      } catch (err) {
        console.error(err);
        showToast('Không thể tạo thương hiệu', 'error');
      }
    }); --}}

    // 3) Sửa/Xóa bằng event delegation
    document.getElementById('brandsTable').addEventListener('click', async (e) => {
      const delBtn = e.target.closest('.btn-delete');
      const restoreBtn = e.target.closest('.btn-restore');
      const purgeBtn = e.target.closest('.btn-purge');

      if (delBtn) {
        const id = delBtn.dataset.id;
        const brandName = delBtn.dataset.name;
        if (!confirm(`Bạn có chắc chắn muốn xóa thương hiệu "${brandName}"?`)) return;
        try {
          await apiDeleteBrand(id);
          await loadAndRender();
          showToast('Xóa thương hiệu thành công', 'success');
        } catch (err) {
          console.error(err);
          showToast('Không thể xóa thương hiệu', 'error');
        }
      } else if (restoreBtn) {
        const id = restoreBtn.dataset.id;
        try {
          await apiRestoreBrand(id);
          await loadAndRender();
          showToast('Khôi phục thương hiệu thành công', 'success');
        } catch (err) {
          console.error(err);
          showToast('Không thể khôi phục thương hiệu', 'error');
        }
      } else if (purgeBtn) {
        const id = purgeBtn.dataset.id;
        if (!confirm('Xóa vĩnh viễn thương hiệu này?')) return;
        try {
          await apiPurgeBrand(id);
          await loadAndRender();
          showToast('Đã xóa vĩnh viễn', 'success');
        } catch (err) {
          console.error(err);
          showToast('Không thể xóa vĩnh viễn', 'error');
        }
      }
    });
    // Lấy modal & input edit
const editBrandModal = document.getElementById('editBrandModal');
const editBrandName = document.getElementById('editBrandName');
const editLogoUrlInput = document.getElementById('editLogoUrlInput');
const editLogoPreview = document.getElementById('editLogoPreview');
const editLogoPreviewPlaceholder = document.getElementById('editLogoPreviewPlaceholder');

let currentEditId = null;
let editLogoMode = 'link';

// Hàm mở modal edit
function openEditBrandModal({ id, name, logo }) {
  currentEditId = id;
  editBrandName.value = name || '';
  editLogoUrlInput.value = logo || '';

  if (logo) {
    editLogoPreview.src = logo;
    editLogoPreview.classList.remove('hidden');
    editLogoPreviewPlaceholder.classList.add('hidden');
  } else {
    editLogoPreview.src = '';
    editLogoPreview.classList.add('hidden');
    editLogoPreviewPlaceholder.classList.remove('hidden');
  }

  editBrandModal.classList.remove('hidden');
  editBrandModal.classList.add('flex');
  editBrandName.focus();
}

// Hàm đóng modal edit
function closeEditBrandModal() {
  editBrandModal.classList.add('hidden');
  editBrandModal.classList.remove('flex');
  currentEditId = null;
}

function setEditSubmitting(b){
  const btn = document.getElementById('submitEditBrandBtn');
  btn.disabled = b;
  btn.innerHTML = b
    ? '<i class="fas fa-spinner fa-spin mr-2"></i>Đang lưu...'
    : '<i class="fas fa-save mr-2"></i>Lưu thay đổi';
}


// Gắn sự kiện cho nút Sửa trên bảng
document.getElementById('brandsTable').addEventListener('click', (e) => {
  const editBtn = e.target.closest('.btn-edit');
  if (!editBtn) return;

  const id   = editBtn.dataset.id;
  const name = editBtn.dataset.name || '';
  const logo = editBtn.dataset.logo || '';

  openEditBrandModal({ id, name, logo });
});

// Đóng modal khi bấm nút X hoặc Hủy
document.getElementById('closeEditBrandModalBtn').addEventListener('click', closeEditBrandModal);
document.getElementById('cancelEditBrandBtn').addEventListener('click', closeEditBrandModal);

// ===== Submit Edit (PUT /api/brands/:id) =====
const submitEditBrandBtn = document.getElementById('submitEditBrandBtn');

submitEditBrandBtn.addEventListener('click', async () => {
  if (!currentEditId) {
    showToast('Thiếu ID thương hiệu cần sửa', 'error');
    return;
  }

  const name = (editBrandName.value || '').trim();
  if (!name) {
    showToast('Tên thương hiệu không được để trống', 'error');
    editBrandName.focus();
    return;
  }

  // Chống trùng tên (loại trừ chính nó)
  if (Array.isArray(currentBrands) && currentBrands.some(
    b => b._id !== currentEditId && (b.name || '').toLowerCase() === name.toLowerCase()
  )) {
    showToast('Tên thương hiệu đã tồn tại', 'error');
    return;
  }

  try {
    setEditSubmitting?.(true);  // nếu bạn đã có helper này

    // Xác định logoUrl theo mode
    let logoUrl = null;

    if (editLogoMode === 'link') {
      const raw = (editLogoUrlInput.value || '').trim();
      logoUrl = raw || null;
    } else {
      // mode = 'file'
      const file = editLogoFileInput.files?.[0];
      if (!file) {
        showToast('Vui lòng chọn file ảnh', 'error');
        setEditSubmitting?.(false);
        return;
      }
      if (!file.type.startsWith('image/')) {
        showToast('Vui lòng chọn đúng file ảnh', 'error');
        setEditSubmitting?.(false);
        return;
      }
      if (file.size > 2 * 1024 * 1024) {
        showToast('Kích thước ảnh tối đa 2MB', 'error');
        setEditSubmitting?.(false);
        return;
      }

      // Upload file để lấy URL (server: POST /api/brands/upload -> { url })
      const fd = new FormData();
      fd.append('file', file);
      const upRes = await fetch(`${API_BASE}/upload`, { method: 'POST', body: fd });
      if (!upRes.ok) throw new Error('Upload thất bại');
      const upJson = await upRes.json();
      logoUrl = upJson.url || null;
    }

    // Gửi PUT cập nhật
    const res = await fetch(`${API_BASE}/${currentEditId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, logo: logoUrl })
    });

    if (!res.ok) {
      const msg = await res.text().catch(() => '');
      throw new Error(msg || `HTTP ${res.status}`);
    }

    // Refresh bảng
    await loadAndRender();
    showToast('Cập nhật thương hiệu thành công', 'success');

    // Đóng modal
    (function closeEdit() {
      const modal = document.getElementById('editBrandModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      currentEditId = null;
    })();
  } catch (err) {
    console.error(err);
    showToast('Không thể cập nhật thương hiệu', 'error');
  } finally {
    setEditSubmitting?.(false);
  }
});

    // 4) Search
    document.getElementById('searchInput').addEventListener('input', (e) => {
      const term = e.target.value.toLowerCase();
      const filtered = currentBrands.filter(b => (b.name || '').toLowerCase().includes(term));
      renderTable(filtered);
    });

    // 5) Refresh
    document.getElementById('refreshBtn').addEventListener('click', async () => {
      document.getElementById('searchInput').value = '';
      await loadAndRender();
      showToast('Dữ liệu đã được làm mới', 'info');
    });
  });
</script>

<script>
  // ====== Modal helpers ======
  const addBrandModal = document.getElementById('addBrandModal');
  const openAddBrandModalBtn = document.getElementById('openAddBrandModalBtn');
  const closeAddBrandModalBtn = document.getElementById('closeAddBrandModalBtn');
  const cancelAddBrandBtn = document.getElementById('cancelAddBrandBtn');
  const submitAddBrandBtn = document.getElementById('submitAddBrandBtn');

  const addBrandName = document.getElementById('addBrandName');
  const logoUrlWrap = document.getElementById('logoUrlWrap');
  const logoFileWrap = document.getElementById('logoFileWrap');
  const logoUrlInput = document.getElementById('logoUrlInput');
  const logoFileInput = document.getElementById('logoFileInput');
  const logoPreview = document.getElementById('logoPreview');
  const logoPreviewPlaceholder = document.getElementById('logoPreviewPlaceholder');

  let logoMode = 'link'; // 'link' | 'file'
  let uploading = false;

  function openAddBrandModal() {
    resetAddBrandForm();
    addBrandModal.classList.remove('hidden');
    addBrandModal.classList.add('flex');
    addBrandName.focus();
  }

  function closeAddBrandModal() {
    addBrandModal.classList.add('hidden');
    addBrandModal.classList.remove('flex');
  }

  function resetAddBrandForm() {
    addBrandName.value = '';
    logoUrlInput.value = '';
    logoFileInput.value = '';
    logoMode = 'link';
    document.querySelectorAll('.logo-mode').forEach(r => {
      r.checked = (r.value === 'link');
    });
    logoUrlWrap.classList.remove('hidden');
    logoFileWrap.classList.add('hidden');
    hidePreview();
    setSubmitting(false);
  }

  function setSubmitting(isSubmitting) {
    uploading = isSubmitting;
    submitAddBrandBtn.disabled = isSubmitting;
    submitAddBrandBtn.innerHTML = isSubmitting
      ? '<i class="fas fa-spinner fa-spin mr-2"></i>Đang lưu...'
      : '<i class="fas fa-save mr-2"></i>Lưu';
  }

  function showPreview(src) {
    if (src) {
      logoPreview.src = src;
      logoPreview.classList.remove('hidden');
      logoPreviewPlaceholder.classList.add('hidden');
    } else {
      hidePreview();
    }
  }

  function hidePreview() {
    logoPreview.src = '';
    logoPreview.classList.add('hidden');
    logoPreviewPlaceholder.classList.remove('hidden');
  }

  // Toggle mode
  document.querySelectorAll('.logo-mode').forEach(radio => {
    radio.addEventListener('change', (e) => {
      logoMode = e.target.value;
      if (logoMode === 'link') {
        logoUrlWrap.classList.remove('hidden');
        logoFileWrap.classList.add('hidden');
        // cập nhật preview theo URL hiện có
        showPreview(logoUrlInput.value.trim() || null);
      } else {
        logoUrlWrap.classList.add('hidden');
        logoFileWrap.classList.remove('hidden');
        // xóa preview, đợi người dùng chọn file
        hidePreview();
      }
    });
  });

  // Preview khi nhập URL
  logoUrlInput.addEventListener('input', () => {
    if (logoMode === 'link') {
      const url = logoUrlInput.value.trim();
      showPreview(url || null);
    }
  });

  // Preview khi chọn file
  logoFileInput.addEventListener('change', () => {
    if (logoMode !== 'file') return;
    const file = logoFileInput.files?.[0];
    if (!file) { hidePreview(); return; }
    if (!file.type.startsWith('image/')) {
      showToast('Vui lòng chọn đúng file ảnh', 'error');
      logoFileInput.value = '';
      hidePreview();
      return;
    }
    if (file.size > 2 * 1024 * 1024) {
      showToast('Kích thước ảnh tối đa 2MB', 'error');
      logoFileInput.value = '';
      hidePreview();
      return;
    }
    const src = URL.createObjectURL(file);
    showPreview(src);
  });

  // Open/close
  openAddBrandModalBtn.addEventListener('click', openAddBrandModal);
  closeAddBrandModalBtn.addEventListener('click', closeAddBrandModal);
  cancelAddBrandBtn.addEventListener('click', closeAddBrandModal);
  addBrandModal.addEventListener('click', (e) => {
    if (e.target === addBrandModal) closeAddBrandModal(); // click outside
  });

  // Submit
  submitAddBrandBtn.addEventListener('click', async () => {
    if (uploading) return;
    const name = addBrandName.value.trim();
    if (!name) {
      showToast('Vui lòng nhập tên thương hiệu', 'error');
      addBrandName.focus();
      return;
    }

    try {
      setSubmitting(true);

      let logoUrl = null;

      if (logoMode === 'link') {
        const raw = (logoUrlInput.value || '').trim();
        logoUrl = raw || null;
      } else {
        const file = logoFileInput.files?.[0];
        if (!file) {
          showToast('Vui lòng chọn file ảnh', 'error');
          setSubmitting(false);
          return;
        }
        // Upload file -> nhận về URL
        const fd = new FormData();
        fd.append('file', file);
        const upRes = await fetch('/brands/upload', { method: 'POST', body: fd });
        if (!upRes.ok) throw new Error('Upload thất bại');
        const upJson = await upRes.json();
        logoUrl = upJson.url; // server trả { url: '/uploads/brands/xxx.png' }
      }

      // Tạo brand
      await apiCreateBrand({ name, logo: logoUrl });
      await loadAndRender();
      showToast('Thêm thương hiệu thành công', 'success');
      closeAddBrandModal();
    } catch (err) {
      console.error(err);
      showToast('Không thể thêm thương hiệu', 'error');
    } finally {
      setSubmitting(false);
    }
  });
</script>
