        </div>
      </div>

      {{!-- Xem trước --}}
      <div>
        <label class="block text-sm font-medium text-hipc-gray mb-2">Xem trước</label>
        <div class="border rounded-lg p-4 flex items-center justify-center min-h-[140px]">
          <img id="editLogoPreview" alt="Xem trước logo" class="max-h-24 object-contain hidden" />
          <div id="editLogoPreviewPlaceholder" class="text-hipc-gray text-sm">
            Chưa có ảnh xem trước
          </div>
        </div>
      </div>
    </div>

    <div class="px-6 py-4 border-t flex items-center justify-end gap-3">
      <button id="cancelEditBrandBtn"
              class="px-4 py-2 rounded-lg border border-gray-300 text-hipc-dark hover:bg-gray-50">
        Hủy
      </button>
      <button id="submitEditBrandBtn"
              class="bg-blue-500 hover:bg-blue-600 text-white font-medium px-4 py-2 rounded-lg transition-all duration-200">
        <i class="fas fa-save mr-2"></i>Lưu thay đổi
      </button>
    </div>
  </div>
</div>

<header class="floating-header sticky top-0 z-50 py-4 px-6 mb-8" style="background: white;">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
