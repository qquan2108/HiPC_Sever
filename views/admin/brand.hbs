{{!-- views/brands.hbs --}}
{{!-- NOTE: Layout ngoài đã lo <html>, <head>, tailwind, font-awesome... --}}
{{!-- Add Brand Modal --}}
<div id="addBrandModal"
     class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/40">
  <div class="bg-white w-full max-w-xl rounded-2xl shadow-xl overflow-hidden">
    <div class="px-6 py-4 border-b flex items-center justify-between">
      <h3 class="text-lg font-semibold text-hipc-dark">Thêm thương hiệu</h3>
      <button id="closeAddBrandModalBtn" class="text-hipc-gray hover:text-hipc-dark">
        <i class="fas fa-times text-lg"></i>
      </button>
    </div>

    <div class="p-6 space-y-5">
      {{!-- Tên thương hiệu --}}
      <div>
        <label class="block text-sm font-medium text-hipc-gray mb-1">Tên thương hiệu *</label>
        <input id="addBrandName"
               type="text"
               placeholder="VD: ASUS, Intel, AMD..."
               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-hipc-blue focus:border-transparent"
               required />
      </div>

      {{!-- Chọn cách nhập ảnh --}}
      <div>
        <label class="block text-sm font-medium text-hipc-gray mb-2">Ảnh logo</label>
        <div class="flex items-center gap-4 mb-3">
          <label class="inline-flex items-center gap-2 cursor-pointer">
            <input type="radio" name="logoMode" value="link" class="logo-mode"
                   checked />
            <span>Dán link ảnh</span>
          </label>
          <label class="inline-flex items-center gap-2 cursor-pointer">
            <input type="radio" name="logoMode" value="file" class="logo-mode" />
            <span>Tải file lên</span>
          </label>
        </div>

        {{!-- Nhập link --}}
        <div id="logoUrlWrap" class="space-y-2">
          <input id="logoUrlInput"
                 type="url"
                 placeholder="https://example.com/logo.png"
                 class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-hipc-blue focus:border-transparent" />
        </div>

        {{!-- Tải file --}}
        <div id="logoFileWrap" class="space-y-2 hidden">
          <input id="logoFileInput"
                 type="file"
                 accept="image/*"
                 class="block w-full text-sm text-hipc-gray file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-hipc-light-blue file:text-white hover:file:bg-blue-600" />
          <p class="text-xs text-hipc-gray">Tối đa 2MB. Định dạng: JPG, PNG, WEBP…</p>
        </div>
      </div>

      {{!-- Xem trước --}}
      <div>
        <label class="block text-sm font-medium text-hipc-gray mb-2">Xem trước</label>
        <div class="border rounded-lg p-4 flex items-center justify-center min-h-[140px]">
          <img id="logoPreview"
               alt="Xem trước logo"
               class="max-h-24 object-contain hidden" />
          <div id="logoPreviewPlaceholder" class="text-hipc-gray text-sm">
            Chưa có ảnh xem trước
          </div>
        </div>
      </div>
    </div>

    <div class="px-6 py-4 border-t flex items-center justify-end gap-3">
      <button id="cancelAddBrandBtn"
              class="px-4 py-2 rounded-lg border border-gray-300 text-hipc-dark hover:bg-gray-50">
        Hủy
      </button>
      <button id="submitAddBrandBtn"
              class="bg-blue-500 hover:bg-blue-600 text-white font-medium px-4 py-2 rounded-lg transition-all duration-200">
        <i class="fas fa-save mr-2"></i>Lưu
      </button>
    </div>
  </div>
</div>

{{!-- Edit Brand Modal --}}
