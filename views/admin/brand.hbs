      <button id="closeEditBrandModalBtn" class="text-hipc-gray hover:text-hipc-dark">
        <i class="fas fa-times text-lg"></i>
      </button>
    </div>

    <div class="p-6 space-y-5">
      {{!-- Tên thương hiệu --}}
