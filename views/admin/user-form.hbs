{{#*inline "title"}}
  {{#if user._id}}Chỉnh sửa Người dùng{{else}}Tạo Người dùng{{/if}}
{{/inline}}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<style>
  body {
  }
  .user-form-card {
    background: rgba(255,255,255,0.22);
    backdrop-filter: blur(18px);
    border-radius: 2rem;
    box-shadow: 0 12px 40px 0 rgba(161,140,209,0.25), 0 1.5px 8px 0 #fff2;
    max-width: 440px;
    margin: 48px auto;
    padding: 2.7rem 2.2rem 2.2rem 2.2rem;
    animation: fadeInUp 0.9s cubic-bezier(.39,.575,.565,1) both;
    border: 1.5px solid rgba(255,255,255,0.25);
    position: relative;
    z-index: 1;
  }
  @keyframes fadeInUp {
    0% { opacity: 0; transform: translateY(40px);}
    100% { opacity: 1; transform: translateY(0);}
  }
  .user-form-card h2 {
    color: #a18cd1;
    font-weight: 700;
    text-align: center;
    margin-bottom: 1.7rem;
    text-shadow: 0 2px 12px #fbc2eb55, 0 1px 0 #fff;
    letter-spacing: 1px;
    font-size: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    animation: fadeIn 1.2s;
  }
  .form-label {
    color: #6c3483;
    font-weight: 500;
    margin-bottom: 0.3rem;
    letter-spacing: 0.5px;
  }
  .form-control {
    border-radius: 1rem;
    border: none;
    background: rgba(255,255,255,0.8);
    box-shadow: 0 2px 8px 0 rgba(161,140,209,0.08);
    transition: box-shadow 0.2s, background 0.2s;
    font-size: 1.05rem;
    padding: 0.7rem 1rem;
  }
  .form-control:focus {
    box-shadow: 0 0 0 2px #a18cd1, 0 0 8px #fbc2eb;
    background: #fff;
  }
  .input-group-text {
    background: rgba(255,255,255,0.7);
    border: none;
    color: #a18cd1;
    border-radius: 1rem 0 0 1rem;
    font-size: 1.1rem;
    transition: background 0.2s;
  }
  .input-group:focus-within .input-group-text {
    background: #fbc2eb;
    color: #fff;
  }
  .btn-primary {
    background: linear-gradient(90deg, #ffb6b9 0%, #a18cd1 100%);
    border: none;
    color: #fff;
    font-weight: 600;
    letter-spacing: 1px;
    box-shadow: 0 4px 16px 0 rgba(255,182,185,0.15);
    transition: transform 0.2s, box-shadow 0.2s;
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    padding: 0.7rem 2.2rem;
  }
  .btn-primary:before {
    content: "";
    position: absolute;
    left: -75%;
    top: 0;
    width: 50%;
    height: 100%;
    background: rgba(255,255,255,0.2);
    transform: skewX(-20deg);
    transition: left 0.4s;
    z-index: 0;
  }
  .btn-primary:hover:before {
    left: 120%;
  }
  .btn-primary:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 8px 24px 0 rgba(255,182,185,0.25);
  }
  .btn-secondary {
    border-radius: 1rem;
    padding: 0.7rem 2.2rem;
    background: #fff;
    color: #a18cd1;
    border: 1.5px solid #a18cd1;
    font-weight: 500;
    transition: background 0.2s, color 0.2s, border 0.2s;
  }
  .btn-secondary:hover {
    background: #a18cd1;
    color: #fff;
    border: 1.5px solid #a18cd1;
  }
  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    margin-top: 1.7rem;
  }
  .fade-in {
    animation: fadeIn 1.2s;
  }
  @keyframes fadeIn {
    from { opacity: 0;}
    to { opacity: 1;}
  }
  /* Hiệu ứng icon khi focus input */
  .input-group:focus-within .input-group-text i {
    animation: bounce 0.5s;
    color: #fff;
    text-shadow: 0 0 8px #a18cd1;
  }
  @keyframes bounce {
    0% { transform: scale(1);}
    30% { transform: scale(1.2);}
    60% { transform: scale(0.95);}
    100% { transform: scale(1);}
  }
</style>

<div class="user-form-card fade-in">
  <h2>
    {{#if user._id}}<i class="fas fa-user-edit"></i>Chỉnh sửa Người dùng{{else}}<i class="fas fa-user-plus"></i>Tạo Người dùng{{/if}}
  </h2>
  <form id="userForm" autocomplete="off">
    {{#if user._id}}
      <input type="hidden" name="id" value="{{user._id}}">
    {{/if}}
    <div class="mb-3">
      <label class="form-label" for="full_name">Họ tên</label>
      <div class="input-group">
        <span class="input-group-text"><i class="fas fa-user"></i></span>
        <input type="text" class="form-control" id="full_name" name="full_name" value="{{user.full_name}}" required>
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label" for="email">Email</label>
      <div class="input-group">
        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
        <input type="email" class="form-control" id="email" name="email" value="{{user.email}}" {{#if user._id}}disabled{{/if}} required>
      </div>
    </div>
    {{#unless user._id}}
    <div class="mb-3">
      <label class="form-label" for="password">Mật khẩu</label>
      <div class="input-group">
        <span class="input-group-text"><i class="fas fa-lock"></i></span>
        <input type="password" class="form-control" id="password" name="password" required>
      </div>
    </div>
    {{/unless}}
    <div class="mb-3">
      <label class="form-label" for="phone">Số điện thoại</label>
      <div class="input-group">
        <span class="input-group-text"><i class="fas fa-phone"></i></span>
        <input type="text" class="form-control" id="phone" name="phone" value="{{user.phone}}">
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label" for="address">Địa chỉ</label>
      <div class="input-group">
        <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
        <input type="text" class="form-control" id="address" name="address" value="{{user.address}}">
      </div>
    </div>
    <div class="modal-footer">
      <button type="submit" class="btn btn-primary px-4">
        <i class="fas fa-save me-2"></i>Lưu
      </button>
      <a href="/admin/users" class="btn btn-secondary px-4">Hủy</a>
    </div>
  </form>
</div>
<script src="/admin/static/js/user-form.js"></script>
