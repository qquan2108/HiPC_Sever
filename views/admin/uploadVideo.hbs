<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Upload Video</title>
</head>
<body>
  <h1>Upload Video</h1>
  <form action="/api/videos/upload" method="POST" enctype="multipart/form-data">
    <label for="title">Tiêu đề video:</label><br />
    <input type="text" name="title" required /><br /><br />

    <label for="comboId">Combo ID:</label><br />
    <input type="text" name="comboId" required /><br /><br />

    <label for="video">Chọn file video:</label><br />
    <input type="file" name="video" accept="video/*" required /><br /><br />

    <button type="submit">Upload</button>
  </form>
</body>
</html>
