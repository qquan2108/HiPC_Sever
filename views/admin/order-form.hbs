{{#*inline "title"}}
{{#ifEquals mode 'edit'}}Chỉnh sửa Đơn hàng{{else}}Tạo Đơn hàng{{/ifEquals}}
{{/inline}}

<link rel="stylesheet" href="/admin/static/css/order.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<style>
  body {
    background: linear-gradient(120deg, #a18cd1 0%, #fbc2eb 100%);
    min-height: 100vh;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }
  .order-form-card {
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(18px);
    border-radius: 2rem;
    box-shadow: 0 12px 40px 0 rgba(161,140,209,0.15), 0 1.5px 8px 0 #fff2;
    max-width: 520px;
    margin: 48px auto;
    padding: 2.7rem 2.2rem 2.2rem 2.2rem;
    animation: fadeInUp 0.9s cubic-bezier(.39,.575,.565,1) both;
    border: 1.5px solid rgba(255,255,255,0.25);
    position: relative;
    z-index: 1;
  }
  @keyframes fadeInUp {
    0% { opacity: 0; transform: translateY(40px);}
    100% { opacity: 1; transform: translateY(0);}
  }
  .order-form-card h2 {
    color: #a18cd1;
    font-weight: 700;
    text-align: center;
    margin-bottom: 1.7rem;
    text-shadow: 0 2px 12px #fbc2eb55, 0 1px 0 #fff;
    letter-spacing: 1px;
    font-size: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    animation: fadeIn 1.2s;
  }
  .form-label {
    color: #6c3483;
    font-weight: 500;
    margin-bottom: 0.3rem;
    letter-spacing: 0.5px;
  }
  .input, textarea.input {
    border-radius: 1rem;
    border: none;
    background: rgba(255,255,255,0.8);
    box-shadow: 0 2px 8px 0 rgba(161,140,209,0.08);
    transition: box-shadow 0.2s, background 0.2s;
    font-size: 1.05rem;
    padding: 0.7rem 1rem;
    width: 100%;
    margin-top: 0.2rem;
    margin-bottom: 0.2rem;
  }
  .input:focus, textarea.input:focus {
    box-shadow: 0 0 0 2px #a18cd1, 0 0 8px #fbc2eb;
    background: #fff;
    outline: none;
  }
  .order-btn, .btn {
    background: linear-gradient(90deg, #ffb6b9 0%, #a18cd1 100%);
    border: none;
    color: #fff;
    font-weight: 600;
    letter-spacing: 1px;
    box-shadow: 0 4px 16px 0 rgba(255,182,185,0.15);
    transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
    border-radius: 1rem;
    padding: 0.7rem 2.2rem;
    font-size: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .order-btn:hover, .btn:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 8px 24px 0 rgba(255,182,185,0.25);
    background: linear-gradient(90deg, #a18cd1 0%, #ffb6b9 100%);
    color: #fff;
  }
  .btn-secondary {
    background: #fff;
    color: #a18cd1;
    border: 1.5px solid #a18cd1;
    font-weight: 500;
    transition: background 0.2s, color 0.2s, border 0.2s;
    border-radius: 1rem;
  }
  .btn-secondary:hover {
    background: #a18cd1;
    color: #fff;
    border: 1.5px solid #a18cd1;
  }
  .btn-danger {
    background: linear-gradient(135deg, #f5576c 0%, #f093fb 100%);
    color: #fff;
    border: none;
    border-radius: 1rem;
    font-weight: 500;
    transition: background 0.2s, box-shadow 0.2s;
  }
  .btn-danger:hover {
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    box-shadow: 0 8px 24px 0 rgba(245, 87, 108, 0.15);
  }
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1.2rem;
    border-radius: 1rem;
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    margin-top: 0.2rem;
    box-shadow: 0 2px 8px 0 rgba(161,140,209,0.08);
    transition: background 0.2s, color 0.2s;
  }
  .status-pending { background: #fff3cd; color: #856404; }
  .status-packed { background: #e3f2fd; color: #1976d2; }
  .status-shipping { background: #e0f2f1; color: #00796b; }
  .status-delivered { background: #e2f7e1; color: #1e4620; }
  .status-return_requested { background: #fffde7; color: #fbc02d; }
  .status-cancelled { background: #f8d7da; color: #842029; }
  .status-icon {
    font-size: 1.1em;
  }
  .flex { display: flex; }
  .space-x-2 > * + * { margin-left: 0.5rem; }
  .mb-4 { margin-bottom: 1.2rem; }
  .mb-2 { margin-bottom: 0.7rem; }
  .mb-6 { margin-bottom: 2rem; }
  .mt-2 { margin-top: 0.7rem; }
  .w-full { width: 100%; }
  .block { display: block; }
  .text-center { text-align: center; }
  .fade-in { animation: fadeIn 1s; }
  @keyframes fadeIn {
    from { opacity: 0;}
    to { opacity: 1;}
  }
</style>

<div class="order-form-card fade-in">
  <h2>
    {{#ifEquals mode 'edit'}}<i class="fas fa-edit"></i> Chỉnh sửa Đơn hàng{{else}}<i class="fas fa-plus"></i> Tạo Đơn hàng{{/ifEquals}}
  </h2>
  <form id="orderForm" data-mode="{{mode}}" data-id="{{order._id}}" data-status="{{order.status}}">
    <div class="mb-4">
      <label class="form-label block">Khách hàng</label>
      <input type="text" name="user_id" value="{{order.user_id.full_name}}" class="input" {{#ifEquals mode 'edit'}}disabled{{/ifEquals}}>
    </div>
    <div class="mb-4">
      <label class="form-label block">Địa chỉ</label>
      <textarea name="address" class="input" {{#ifEquals mode 'edit'}}readonly{{/ifEquals}}>{{order.address}}</textarea>
    </div>
    <div class="mb-4">
      <label class="form-label block">Phương thức thanh toán</label>
      <input type="text" name="paymentMethod" value="{{order.paymentMethod}}" class="input" {{#ifEquals mode 'edit'}}readonly{{/ifEquals}}>
    </div>
    <div class="mb-4">
      <label class="form-label block">Phương thức vận chuyển</label>
      <input type="text" name="shippingMethod" value="{{order.shippingMethod}}" class="input" {{#ifEquals mode 'edit'}}readonly{{/ifEquals}}>
    </div>
    <div class="mb-4">
      <label class="form-label block">Tổng tiền</label>
      <input type="number" name="total" value="{{order.total}}" class="input" {{#ifEquals mode 'edit'}}readonly{{/ifEquals}}>
    </div>
    <div class="mb-4">
      <label class="form-label block">Sản phẩm đã mua</label>
      <div class="order-products-list mb-2">
        {{#if order.products.length}}
          {{#each order.products}}
            <div>
              <strong>{{this.product.name}}</strong>
              <span class="qty">x{{this.quantity}}</span>
            </div>
          {{/each}}
        {{else}}
          <div class="text-gray-400">Chưa có sản phẩm</div>
        {{/if}}
      </div>
    </div>
    {{#ifEquals mode 'edit'}}
    <div class="mb-4">
      <label class="form-label block">Trạng thái đơn hàng</label>
      <select name="status" class="input">
        <option value="pending" {{#if (eq order.status 'pending')}}selected{{/if}}>Chờ xác nhận</option>
        <option value="packed" {{#if (eq order.status 'packed')}}selected{{/if}}>Chờ lấy hàng</option>
        <option value="shipping" {{#if (eq order.status 'shipping')}}selected{{/if}}>Chờ giao hàng</option>
        <option value="delivered" {{#if (eq order.status 'delivered')}}selected{{/if}}>Đã giao</option>
        <option value="return_requested" {{#if (eq order.status 'return_requested')}}selected{{/if}}>Trả hàng</option>
        <option value="cancelled" {{#if (eq order.status 'cancelled')}}selected{{/if}}>Đã huỷ</option>
      </select>
    </div>
    <div id="statusButtons" class="flex space-x-2 mb-4"></div>
    {{/ifEquals}}
    <div class="flex space-x-2 mt-2">
      <button type="submit" class="btn order-btn"><i class="fas fa-save"></i> Lưu</button>
      <a href="/admin/orders" class="btn btn-secondary">Hủy</a>
    </div>
  </form>
</div>

<script>
  window.orderTransitions = {{{json transitions}}};

  function getStatusIcon(status) {
      const icons = {
          pending: 'fas fa-clock',
          packed: 'fas fa-box',
          shipping: 'fas fa-truck',
          delivered: 'fas fa-check-double',
          return_requested: 'fas fa-undo-alt',
          cancelled: 'fas fa-times-circle'
      };
      return icons[status] || 'fas fa-question-circle';
  }

  function getStatusText(status) {
      const texts = {
          pending: 'Chờ xác nhận',
          packed: 'Chờ lấy hàng',
          shipping: 'Chờ giao hàng',
          delivered: 'Đã giao',
          return_requested: 'Trả hàng',
          cancelled: 'Đã huỷ'
      };
      return texts[status] || status;
  }
</script>
<script src="/admin/static/js/order.js"></script>