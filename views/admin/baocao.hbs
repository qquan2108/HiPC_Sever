{{#*inline "title"}}Báo cáo Thống kê Doanh thu{{/inline}}

<!-- Bootstrap CSS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
<!-- Animate.css & AOS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" rel="stylesheet">
<!-- Premium font -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<!-- Icons -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<!-- Custom CSS for báo cáo -->
<link rel="stylesheet" href="/admin/static/css/baocao.css" />

<style>
    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        background: linear-gradient(120deg, #a18cd1 0%, #fbc2eb 100%);
        min-height: 100vh;
    }
    .baocao-title-bar {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        background: linear-gradient(90deg, #a18cd1 0%, #fbc2eb 100%);
        color: #fff;
        font-weight: 700;
        font-size: 1.35rem;
        border-radius: 1.2rem;
        padding: 0.8rem 2rem 0.8rem 1.5rem;
        margin: 2rem 0 1.5rem 0;
        box-shadow: 0 4px 24px 0 rgba(161,140,209,0.13);
        width: fit-content;
        min-width: 320px;
        max-width: 100%;
        animation: fadeInDown 0.7s;
    }
    .baocao-title-bar i {
        font-size: 1.5rem;
        filter: drop-shadow(0 2px 8px #fff);
    }
    @keyframes fadeInDown {
        from { opacity: 0; transform: translateY(-30px);}
        to { opacity: 1; transform: translateY(0);}
    }
    .premium-header {
        background: linear-gradient(90deg, #a18cd1 0%, #fbc2eb 100%);
        box-shadow: 0 8px 32px 0 rgba(161,140,209,0.18);
        padding: 2.8rem 0 2rem 0;
        border-radius: 0 0 2.5rem 2.5rem;
        margin-bottom: 2.5rem;
        animation: fadeInDown 1s;
        position: relative;
        overflow: hidden;
    }
    .premium-header::after {
        content: "";
        position: absolute;
        right: -120px;
        top: -60px;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, #fff 0%, #fbc2eb00 80%);
        opacity: 0.18;
        z-index: 0;
        pointer-events: none;
        animation: headerGlow 3s infinite alternate;
    }
    @keyframes headerGlow {
        0% { opacity: 0.18; }
        100% { opacity: 0.32; }
    }
    .premium-header h1 {
        color: #fff;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-shadow: 0 4px 24px #a18cd1, 0 1px 0 #fff;
        font-size: 2.7rem;
        margin-bottom: 0;
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        animation: tada 1.2s;
    }
    .premium-header h1 i {
        font-size: 2.5rem;
        filter: drop-shadow(0 2px 12px #fff);
        animation: bounceIn 1.2s;
    }
    @keyframes tada {
        0% { transform: scale3d(1, 1, 1);}
        10%, 20% { transform: scale3d(0.9, 0.9, 0.9) rotate(-3deg);}
        30%, 50%, 70%, 90% { transform: scale3d(1.1, 1.1, 1.1) rotate(3deg);}
        40%, 60%, 80% { transform: scale3d(1.1, 1.1, 1.1) rotate(-3deg);}
        100% { transform: scale3d(1, 1, 1);}
    }
    @keyframes bounceIn {
        0% { transform: scale(0.3);}
        50% { transform: scale(1.05);}
        70% { transform: scale(0.9);}
        100% { transform: scale(1);}
    }
    .chart-section, .controls-section {
        background: rgba(255,255,255,0.97);
        border-radius: 1.7rem;
        box-shadow: 0 12px 40px 0 rgba(161,140,209,0.14);
        padding: 2.2rem 2rem 2rem 2rem;
        margin-bottom: 2.2rem;
        animation: fadeInUp 1.1s;
    }
    .chart-title, .controls-title {
        color: #a18cd1;
        font-weight: 700;
        font-size: 1.45rem;
        margin-bottom: 1.3rem;
        display: flex;
        align-items: center;
        gap: 0.7rem;
        letter-spacing: 0.5px;
    }
    .chart-title i, .controls-title i {
        font-size: 1.4rem;
        filter: drop-shadow(0 2px 8px #fbc2eb88);
    }
    .chart-container {
        background: linear-gradient(135deg, #f3e8ff 60%, #fbc2eb 100%);
        border-radius: 1.5rem;
        padding: 2.5rem 2rem;
        box-shadow: 0 4px 24px 0 rgba(161,140,209,0.13);
        min-height: 420px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: visible;
        animation: fadeIn 1.2s;
    }
    .chart-container.large {
        min-height: 480px;
    }
    .chart-container::before {
        content: "";
        position: absolute;
        left: -60px;
        top: -60px;
        width: 180px;
        height: 180px;
        background: radial-gradient(circle, #a18cd1 0%, #fff0 80%);
        opacity: 0.09;
        z-index: 0;
        pointer-events: none;
    }
    .controls-row .form-label {
        color: #6c3483;
        font-weight: 500;
    }
    .form-select, .form-control {
        border-radius: 1.1rem;
        border: none;
        background: rgba(255,255,255,0.85);
        box-shadow: 0 2px 8px 0 rgba(161,140,209,0.08);
        font-size: 1.08rem;
        padding: 0.8rem 1.1rem;
        margin-bottom: 0.5rem;
        transition: box-shadow 0.2s, background 0.2s;
    }
    .form-select:focus, .form-control:focus {
        box-shadow: 0 0 0 2px #a18cd1, 0 0 8px #fbc2eb;
        background: #fff;
    }
    .btn-primary {
        background: linear-gradient(90deg, #ffb6b9 0%, #a18cd1 100%);
        border: none;
        color: #fff;
        font-weight: 700;
        letter-spacing: 1px;
        box-shadow: 0 4px 16px 0 rgba(255,182,185,0.15);
        border-radius: 1.2rem;
        padding: 0.8rem 2.4rem;
        font-size: 1.08rem;
        transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
        display: flex;
        align-items: center;
        gap: 0.7rem;
    }
    .btn-primary:hover {
        transform: translateY(-2px) scale(1.04);
        box-shadow: 0 8px 24px 0 rgba(255,182,185,0.25);
        background: linear-gradient(90deg, #a18cd1 0%, #ffb6b9 100%);
        color: #fff;
    }
    .comparison-controls {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }
    .comparison-controls > div {
        flex: 1 1 45%;
        min-width: 140px;
    }
    .modal-content {
        border-radius: 1.5rem;
        box-shadow: 0 8px 32px 0 rgba(161,140,209,0.13);
    }
    .modal-title {
        color: #a18cd1;
        font-weight: 700;
    }
    .table thead th {
        color: #a18cd1;
        font-weight: 700;
        font-size: 1.08rem;
        background: #f3e8ff;
        border-top: none;
    }
    .table-hover tbody tr:hover {
        background: #fbc2eb22;
    }
    .loading-spinner {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(255,255,255,0.5);
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
    }
    .loading-spinner .spinner {
        border: 6px solid #f3e8ff;
        border-top: 6px solid #a18cd1;
        border-radius: 50%;
        width: 60px;
        height: 60px;
        animation: spin 1s linear infinite;
        box-shadow: 0 2px 12px #a18cd1;
    }
    @keyframes spin {
        0% { transform: rotate(0deg);}
        100% { transform: rotate(360deg);}
    }
    @keyframes fadeInDown {
        from { opacity: 0; transform: translateY(-40px);}
        to { opacity: 1; transform: translateY(0);}
    }
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(40px);}
        to { opacity: 1; transform: translateY(0);}
    }
    @keyframes fadeIn {
        from { opacity: 0;}
        to { opacity: 1;}
    }
    /* Responsive */
    @media (max-width: 991px) {
        .chart-section, .controls-section { margin-bottom: 1.2rem; }
        .chart-container { min-height: 260px; padding: 1.2rem; }
        .chart-container.large { min-height: 320px; }
    }
    @media (max-width: 767px) {
        .premium-header { padding: 1.2rem 0 1rem 0; }
        .chart-section, .controls-section { padding: 1.2rem 0.7rem; }
        .modal-content { border-radius: 1rem; }
        .chart-title, .controls-title { font-size: 1.1rem; }
    }
</style>

<header class="floating-header sticky top-0 z-50 py-4 px-6 mb-8" style="background: white;">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-4">
                <div class="p-3 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl">
                    <i class="fas fa-chart-line text-white text-xl"></i>
                </div>
                <h1 class="text-3xl font-bold bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">
                    Báo cáo Thống kê Doanh thu
                </h1>
            </div>
        </div>
    </header>

<main class="container-fluid px-3 px-md-4">
    <div class="row">
        <div class="col-lg-7">
            <section class="chart-section" data-aos="zoom-in-up" data-aos-delay="120">
                <h3 class="chart-title">
                    <i class="fas fa-chart-bar"></i>
                    Biểu đồ doanh thu
                </h3>
                <div class="chart-container large fullscreen shadow-lg animate__animated animate__fadeIn">
                    <canvas id="revenueChart"></canvas>
                </div>
            </section>
        </div>
        <div class="col-lg-5">
            <section class="controls-section" data-aos="fade-up" data-aos-delay="100">
                <h3 class="controls-title">
                    <i class="fas fa-filter"></i>
                    Bộ lọc thời gian
                </h3>
                <div class="row g-3 align-items-end controls-row">
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Loại thống kê</label>
                        <select id="periodSelect" class="form-select">
                            <option value="month" selected>Theo tháng</option>
                            <option value="week">Theo tuần</option>
                            <option value="year">Theo năm</option>
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Chọn thời gian</label>
                        <input type="month" id="monthInput" class="form-control" />
                        <input type="week" id="weekInput" class="form-control d-none" />
                        <input type="number" id="yearInput" class="form-control d-none" min="2000" max="2100" placeholder="Năm" />
                    </div>
                    <div class="col-md-12">
                        <button id="loadRevenue" class="btn btn-primary w-100 animate__animated animate__pulse">
                            <i class="fas fa-search me-2"></i>
                            Xem báo cáo
                        </button>
                        <button type="button" class="btn btn-primary w-100 mt-3 animate__animated animate__pulse" data-bs-toggle="modal" data-bs-target="#tableModal">
                    <i class="fas fa-table me-2"></i>
                    Xem bảng chi tiết
                </button>
                    </div>
                    
                </div>
            </section>
            <section class="controls-section mt-3" data-aos="fade-up" data-aos-delay="200">
                <h3 class="controls-title">
                    <i class="fas fa-balance-scale"></i>
                    So sánh doanh thu
                </h3>
                <div class="comparison-controls">
                    <div>
                        <label class="form-label fw-semibold">Tháng thứ nhất</label>
                        <select id="month1" class="form-select" aria-label="Tháng so sánh 1">
                            <option value="">Chọn tháng...</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label fw-semibold">Tháng thứ hai</label>
                        <select id="month2" class="form-select" aria-label="Tháng so sánh 2">
                            <option value="">Chọn tháng...</option>
                        </select>
                    </div>
                    <div>
                        <button id="compareBtn" class="btn btn-primary w-100 animate__animated animate__pulse">
                            <i class="fas fa-chart-line me-2"></i>
                            So sánh
                        </button>
                    </div>
                </div>
            </section>
        </div>
    </div>
</main>

<!-- Detail Table Modal -->
<div class="modal fade" id="tableModal" tabindex="-1" aria-labelledby="tableModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tableModalLabel">
                    <i class="fas fa-table me-2"></i>Bảng chi tiết doanh thu
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th><i class="fas fa-calendar me-2"></i>Thời gian</th>
                                <th class="text-end"><i class="fas fa-money-bill-wave me-2"></i>Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody id="revenueTable">
                            <tr>
                                <td colspan="2" class="text-center text-muted py-4">
                                    <i class="fas fa-info-circle me-2"></i>
                                    Chọn thời gian và nhấn "Xem báo cáo" để hiển thị dữ liệu
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Loading Spinner -->
<div class="loading-spinner" id="loadingSpinner">
    <div class="spinner"></div>
</div>

<!-- Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/countup.js/2.9.0/countUp.umd.js"></script>
<script src="/admin/static/js/baocao.js"></script>
<script>
    AOS.init({ once: true, duration: 900 });
    // Hiệu ứng loading spinner
    document.addEventListener('DOMContentLoaded', function() {
        const spinner = document.getElementById('loadingSpinner');
        document.addEventListener('baocao:loading', () => spinner.style.display = 'flex');
        document.addEventListener('baocao:loaded', () => spinner.style.display = 'none');
    });
</script>