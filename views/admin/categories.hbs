<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quản lý Danh mục</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <style>
    body {
      min-height: 100vh;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    }

    .btn-primary {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      transform: translateY(0);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 40px -12px rgba(102, 126, 234, 0.4);
    }

    .btn-secondary {
      background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      transform: translateY(0);
    }

    .btn-secondary:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 40px -12px rgba(245, 87, 108, 0.4);
    }

    .btn-danger {
      background: linear-gradient(135deg, #f5576c 0%, #f093fb 100%);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      transform: translateY(0);
    }

    .btn-danger:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 40px -12px rgba(245, 87, 108, 0.4);
      background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    }

    .table-row {
      transition: all 0.3s ease;
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .table-row:hover {
      background: rgba(102, 126, 234, 0.05);
      transform: translateX(4px);
    }

    .fade-in {
      animation: fadeIn 0.6s ease-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .icon-bounce {
      transition: transform 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    }

    .icon-bounce:hover {
      transform: scale(1.2) rotate(5deg);
    }

    .loading-spinner {
      border: 3px solid rgba(255, 255, 255, 0.3);
      border-top: 3px solid #667eea;
      border-radius: 50%;
      width: 20px;
      height: 20px;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      0% {
        transform: rotate(0deg);
      }

      100% {
        transform: rotate(360deg);
      }
    }

    /* Avatar style for category logo */
    .category-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      object-fit: cover;
      box-shadow: 0 2px 8px 0 rgba(161,140,209,0.13);
      margin-right: 14px;
      border: 2px solid #fbc2eb44;
      background: #fff;
      display: inline-block;
      vertical-align: middle;
    }
    .category-name-cell {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
  </style>

</head>
<header class="floating-header sticky top-0 z-50 py-4 px-6 mb-8" style="background: white;">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-4">
                <div class="p-3 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl">
                    <i class="fas fa-tags text-white text-xl"></i>
                </div>
                <h1 class="text-3xl font-bold bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">
                    Quản lý Danh mục
                </h1>
            </div>
        </div>
    </header>
<body class="glass-bg">
  <div class="max-w-7xl mx-auto px-6 pb-8">
    <!-- Search -->
    <div class="glass-card rounded-2xl p-6 mb-8 fade-in">
      <div class="flex flex-col lg:flex-row lg:justify-between lg:items-center space-y-4 lg:space-y-0">
        <div class="relative lg:w-1/3">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <i class="fas fa-search text-gray-400"></i>
          </div>
          <input id="categorySearch" type="text" placeholder="Tìm theo tên danh mục..."
            class="search-input w-full pl-12 pr-4 py-3 rounded-xl focus:outline-none focus:ring-0 text-gray-700" />
        </div>
        <a href="/admin/categories/create" class="btn-primary text-white px-6 py-3 rounded-xl font-semibold shadow-lg">
        <i class="fas fa-plus mr-2"></i>
        Thêm Danh mục
      </a>
      </div>
    </div>

    <!-- Categories Table -->
    <div class="glass-card rounded-2xl overflow-hidden slide-up">
      <div class="overflow-x-auto">
        <table class="min-w-full">
          <thead class="bg-gradient-to-r from-gray-50 to-gray-100">
            <tr>
              <th class="px-6 py-4 text-left text-sm font-bold text-gray-700 uppercase tracking-wider">#</th>
              <th class="px-6 py-4 text-left text-sm font-bold text-gray-700 uppercase tracking-wider">
                <i class="bx bx-category-alt mr-2"></i>Tên Danh mục
              </th>
              <th class="px-6 py-4 text-left text-sm font-bold text-gray-700 uppercase tracking-wider">
                <i class="fas fa-align-left mr-2"></i>Mô tả
              </th>
              <th class="px-6 py-4 text-center text-sm font-bold text-gray-700 uppercase tracking-wider">
                <i class="fas fa-cogs mr-2"></i>Hành động
              </th>
            </tr>
          </thead>
          <tbody id="categoryTable" class="bg-white divide-y divide-gray-100">
            <!-- Loading state -->
            <tr id="loadingRow">
              <td colspan="4" class="px-6 py-12 text-center">
                <div class="flex justify-center items-center space-x-3">
                  <div class="loading-spinner"></div>
                  <span class="text-gray-500">Đang tải dữ liệu...</span>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    let allCategories = [];
    let isLoading = false;

    async function fetchCategories() {
      setLoading(true);
      const res = await fetch('/category');
      const data = await res.json();
      allCategories = data;
      setLoading(false);
      renderCategories(allCategories);
    }

    function setLoading(loading) {
      isLoading = loading;
      const loadingRow = document.getElementById('loadingRow');
      if (loading) {
        loadingRow.style.display = 'table-row';
      } else {
        loadingRow.style.display = 'none';
      }
    }

    function renderCategories(categories) {
      const tbody = document.getElementById('categoryTable');
      // Clear existing rows except loading row
      const rows = tbody.querySelectorAll('tr:not(#loadingRow)');
      rows.forEach(row => row.remove());

      if (categories.length === 0 && !isLoading) {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td colspan="4" class="px-6 py-12 text-center">
            <div class="flex flex-col items-center space-y-4">
              <i class="fas fa-inbox text-gray-300 text-6xl"></i>
              <p class="text-gray-500 text-lg">Không tìm thấy danh mục nào</p>
            </div>
          </td>
        `;
        tbody.appendChild(tr);
        return;
      }

      categories.forEach((cat, idx) => {
        const tr = document.createElement('tr');
        tr.className = 'table-row fade-in';
        tr.style.animationDelay = `${idx * 0.1}s`;

        tr.innerHTML = `
          <td class="px-6 py-4 whitespace-nowrap">${idx + 1}</td>
          <td class="px-6 py-4 whitespace-nowrap font-semibold text-gray-900 category-name-cell">
            ${cat.image ? `<img src="${cat.image}" alt="${cat.name}" class="category-avatar">` : `<span class="category-avatar" style="background:#f3e8ff;"></span>`}
            <span>${cat.name}</span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-gray-700">${cat.description || ''}</td>
          <td class="px-6 py-4 whitespace-nowrap text-center">
            <div class="flex justify-center space-x-2">
              <a href="/admin/categories/edit/${cat._id}" class="btn-secondary text-white px-3 py-2 rounded-lg text-sm font-medium shadow-md icon-bounce">
                <i class="fas fa-edit"></i>
              </a>
              <button onclick="deleteCategory('${cat._id}')" class="btn-danger text-white px-3 py-2 rounded-lg text-sm font-medium shadow-md icon-bounce">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    async function deleteCategory(id) {
      if (!confirm('Bạn có chắc chắn muốn xóa danh mục này?')) return;
      setLoading(true);
      await fetch(`/category/${id}`, { method: 'DELETE' });
      allCategories = allCategories.filter(c => c._id !== id);
      renderCategories(allCategories);
      setLoading(false);
      showNotification('Danh mục đã được xóa thành công!', 'success');
    }

    function showNotification(message, type = 'info') {
      const notification = document.createElement('div');
      notification.className = `fixed top-4 right-4 z-50 px-6 py-4 rounded-xl shadow-lg transition-all duration-300 transform translate-x-full`;

      if (type === 'success') {
        notification.className += ' bg-green-500 text-white';
      } else if (type === 'error') {
        notification.className += ' bg-red-500 text-white';
      } else {
        notification.className += ' bg-blue-500 text-white';
      }

      notification.innerHTML = `
        <div class="flex items-center">
          <i class="fas fa-check-circle mr-2"></i>
          <span>${message}</span>
        </div>
      `;

      document.body.appendChild(notification);

      setTimeout(() => {
        notification.classList.remove('translate-x-full');
      }, 100);

      setTimeout(() => {
        notification.classList.add('translate-x-full');
        setTimeout(() => {
          document.body.removeChild(notification);
        }, 300);
      }, 3000);
    }

    document.addEventListener('DOMContentLoaded', () => {
      fetchCategories();

      document.getElementById('categorySearch').addEventListener('input', e => {
        const q = e.target.value.trim().toLowerCase();
        renderCategories(allCategories.filter(c =>
          c.name.toLowerCase().includes(q)
        ));
      });
    });
  </script>
</body>

</html>