{{#*inline "title"}}Quản lý Người dùng{{/inline}}

<link rel="stylesheet" href="/admin/static/css/user.css" />

<header class="floating-header sticky top-0 z-50 py-4 px-6 mb-8">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-4">
                <div class="p-3 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl">
                    <i class="fas fa-user text-white text-xl"></i>
                </div>
                <h1 class="text-3xl font-bold bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">
                    Quản lý Người dùng
                </h1>
            </div>
        </div>
    </header>

<div class="container glass-card rounded-2xl p-6 fade-in">
  <!-- Header actions: Thêm & Search -->
  <div class="header-actions mb-4 flex justify-between items-center">
    <input
      type="text"
      id="userSearch"
      placeholder="Tìm kiếm theo tên hoặc email..."
      class="search-input w-1/3 px-4 py-2 rounded"
    />
  </div>
</div>

<!-- Bảng danh sách users -->
<div class="table-container overflow-auto shadow rounded">
  <table class="min-w-full divide-y divide-gray-200 bg-white">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Avatar</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Họ tên</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Vai trò</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Trạng thái</th>
        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Hành động</th>
      </tr>
    </thead>
    <tbody id="userTable" class="bg-white divide-y divide-gray-200"></tbody>
  </table>

  <!-- Pagination Controls -->
  <div id="pagination" class="flex justify-center items-center gap-2 py-4"></div>
</div>

<script>
  let userCurrentPage = 1;
  let userTotalPages = 1;
  const userLimit = 20;
  let allUsers = [];

  async function fetchUsers(page = 1) {
    try {
      const res = await fetch(`/users?page=${page}&limit=${userLimit}`);
      if (!res.ok) throw new Error(`Status ${res.status}`);
      const { users, totalPages } = await res.json();

      allUsers = users;
      renderUsers(users);
      renderPagination(page, totalPages);
      userCurrentPage = page;
      userTotalPages = totalPages;
    } catch (err) {
      console.error('Lỗi tải user:', err);
    }
  }

  function renderUsers(users) {
    const tbody = document.getElementById('userTable');
    tbody.innerHTML = '';
    users.forEach(u => {
      const avatarUrl = u.avatar || 'https://via.placeholder.com/40';
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="px-6 py-4"><img src="${avatarUrl}" alt="avatar" class="w-10 h-10 rounded-full object-cover" /></td>
        <td class="px-6 py-4">${u.name}</td>
        <td class="px-6 py-4">${u.email}</td>
        <td class="px-6 py-4">${u.role}</td>
        <td class="px-6 py-4">${u.active ? 'Hoạt động' : 'Khoá'}</td>
        <td class="px-6 py-4 text-center">
          ${
            u.active
              ? `<a href="#" onclick="lockUser('${u._id}')" class="inline-block mx-1 p-2 hover:bg-gray-100 rounded" title="Khóa user">
                  <i class="bx bx-lock text-xl"></i>
                </a>`
              : `<a href="#" onclick="unlockUser('${u._id}')" class="inline-block mx-1 p-2 hover:bg-gray-100 rounded text-green-600" title="Mở khóa user">
                  <i class="bx bx-lock-open text-xl"></i>
                </a>`
          }
        </td>`;
      tbody.appendChild(tr);
    });
  }

  function renderPagination(current, totalPages) {
    const container = document.getElementById('pagination');
    container.innerHTML = '';

    const createBtn = (label, page, active = false, disabled = false) => {
      const btn = document.createElement('button');
      btn.textContent = label;
      btn.className = `px-3 py-1 rounded border text-sm font-medium ${
        active ? 'bg-purple-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100'
      } ${disabled ? 'opacity-50 cursor-not-allowed' : ''}`;
      if (!disabled) {
        btn.addEventListener('click', () => fetchUsers(page));
      }
      return btn;
    };

    container.appendChild(createBtn('«', current - 1, false, current === 1));
    for (let i = 1; i <= totalPages; i++) {
      container.appendChild(createBtn(i, i, i === current));
    }
    container.appendChild(createBtn('»', current + 1, false, current === totalPages));
  }

  async function lockUser(id) {
    if (!confirm('Bạn có chắc muốn KHÓA user này? User sẽ không đăng nhập được vào hệ thống!')) return;
    try {
      const res = await fetch(`/users/${id}/lock`, { method: 'PATCH' });
      if (!res.ok) throw new Error(`Khóa thất bại: ${res.status}`);
      showToast('Đã khóa user');
      fetchUsers(userCurrentPage);
    } catch (err) {
      showToast('Lỗi khóa user', 'error');
      console.error('Lỗi khóa user:', err);
    }
  }

  async function unlockUser(id) {
    if (!confirm('Bạn có chắc muốn MỞ KHÓA user này?')) return;
    try {
      const res = await fetch(`/users/${id}/unlock`, { method: 'PATCH' });
      if (!res.ok) throw new Error(`Mở khóa thất bại: ${res.status}`);
      showToast('Đã mở khóa user');
      fetchUsers(userCurrentPage);
    } catch (err) {
      showToast('Lỗi mở khóa user', 'error');
      console.error('Lỗi mở khóa user:', err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    fetchUsers(1);
    document.getElementById('userSearch').addEventListener('input', e => {
      const q = e.target.value.trim().toLowerCase();
      renderUsers(allUsers.filter(u =>
        u.name.toLowerCase().includes(q) ||
        u.email.toLowerCase().includes(q)
      ));
    });
  });
</script>
<script>
  function showToast(msg, type = 'success') {
    let toast = document.createElement('div');
    toast.textContent = msg;
    toast.className = `fixed top-6 right-6 z-50 px-4 py-2 rounded shadow text-white transition bg-${type === 'success' ? 'green' : 'red'}-600`;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 2000);
  }
</script>
