{{#*inline "title"}}Quản lý Đơn hàng{{/inline}}

<link rel="stylesheet" href="/admin/static/css/glass.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        body {

            min-height: 100vh;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }
        .glass-card {
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.2);
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.15);
        }
        .btn-primary {
            background: linear-gradient(90deg, #ffb6b9 0%, #a18cd1 100%);
            border: none;
            color: #fff;
            font-weight: 600;
            letter-spacing: 1px;
            box-shadow: 0 4px 16px 0 rgba(255,182,185,0.15);
            transition: transform 0.2s, box-shadow 0.2s;
            border-radius: 1rem;
            padding: 0.7rem 2.2rem;
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .btn-primary:hover {
            transform: translateY(-2px) scale(1.03);
            box-shadow: 0 8px 24px 0 rgba(255,182,185,0.25);
        }
        .btn-secondary {
            border-radius: 1rem;
            padding: 0.7rem 2.2rem;
            background: #fff;
            color: #a18cd1;
            border: 1.5px solid #a18cd1;
            font-weight: 500;
            transition: background 0.2s, color 0.2s, border 0.2s;
        }
        .btn-secondary:hover {
            background: #a18cd1;
            color: #fff;
            border: 1.5px solid #a18cd1;
        }
        .btn-danger {
            background: linear-gradient(135deg, #f5576c 0%, #f093fb 100%);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 1rem;
            color: #fff;
            font-weight: 500;
            padding: 0.7rem 2.2rem;
            border: none;
        }
        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 40px -12px rgba(245, 87, 108, 0.4);
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        }
        .table-row {
            transition: all 0.3s ease;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        .table-row:hover {
            background: rgba(102, 126, 234, 0.05);
            transform: translateX(4px);
        }
        .fade-in {
            animation: fadeIn 0.6s ease-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px);}
            to { opacity: 1; transform: translateY(0);}
        }
        .icon-bounce {
            transition: transform 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }
        .icon-bounce:hover {
            transform: scale(1.2) rotate(5deg);
        }
        .loading-spinner {
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-top: 3px solid #667eea;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            animation: spin 1s linear infinite;
        }
        @keyframes spin {
            0% { transform: rotate(0deg);}
            100% { transform: rotate(360deg);}
        }
        .status-pending { background: #fff3cd; color: #856404; }
        .status-packed { background: #e3f2fd; color: #1976d2; }
        .status-shipping { background: #e0f2f1; color: #00796b; }
        .status-delivered { background: #e2f7e1; color: #1e4620; }
        .status-return_requested { background: #fffde7; color: #fbc02d; }
        .status-cancelled { background: #f8d7da; color: #842029; }
        .order-products-list {
            font-size: 0.95rem;
            color: #555;
            margin-top: 0.2rem;
            margin-bottom: 0.2rem;
        }
        .order-products-list div {
            margin-bottom: 2px;
        }
        .order-products-list strong {
            color: #6c3483;
        }
        .order-products-list .qty {
            color: #f5576c;
            font-weight: 600;
        }
        .tab-active {
            background: linear-gradient(90deg, #a18cd1 0%, #fbc2eb 100%);
            color: #fff;
            box-shadow: 0 2px 8px 0 rgba(161,140,209,0.13);
        }
        .tab-inactive {
            background: #fff;
            color: #a18cd1;
            border: 1.5px solid #a18cd1;
        }
        /* Responsive table */
        @media (max-width: 900px) {
            .glass-card table, .glass-card thead, .glass-card tbody, .glass-card th, .glass-card td, .glass-card tr {
                display: block;
            }
            .glass-card thead tr {
                display: none;
            }
            .glass-card tr {
                margin-bottom: 1.5rem;
                border-radius: 1rem;
                box-shadow: 0 2px 8px 0 rgba(161,140,209,0.13);
                background: #fff;
            }
            .glass-card td {
                padding: 1rem 1rem;
                border: none;
                position: relative;
            }
            .glass-card td:before {
                content: attr(data-label);
                font-weight: bold;
                color: #a18cd1;
                display: block;
                margin-bottom: 0.5rem;
            }
        }
    </style>

    <!-- Header -->
    <header class="floating-header sticky top-0 z-50 py-4 px-6 mb-8">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-4">
                <div class="p-3 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl">
                    <i class="fas fa-shopping-cart text-white text-xl"></i>
                </div>
                <h1 class="text-3xl font-bold bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">
                    Quản lý Đơn hàng
                </h1>
            </div>
            {{!-- <a href="/admin/orders/create" class="btn-primary text-white font-semibold shadow-lg">
                <i class="fas fa-plus"></i>
                Tạo đơn hàng
            </a> --}}
        </div>
    </header>

    <div class="max-w-7xl mx-auto px-6 pb-8">
        <!-- Search and Filters -->
        <div class="glass-card rounded-2xl p-6 mb-8 fade-in">
            <div class="flex flex-col lg:flex-row lg:justify-between lg:items-center space-y-4 lg:space-y-0">
                <!-- Search Input -->
                <div class="relative lg:w-1/3">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <i class="fas fa-search text-gray-400"></i>
                    </div>
                    <input 
                        id="searchInput" 
                        type="text" 
                        placeholder="Tìm kiếm theo mã đơn hoặc tên khách hàng..."
                        class="search-input w-full pl-12 pr-4 py-3 rounded-xl focus:outline-none focus:ring-0 text-gray-700"
                    />
                </div>
                <!-- Status Dropdown -->
                <div>
                    <select id="statusFilter" class="rounded-xl px-4 py-3 border text-gray-700 focus:outline-none">
                        <option value="">Tất cả trạng thái</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Orders Table -->
        <div class="mb-4 text-right">Tổng đơn hàng: <span id="orderCount">0</span></div>
        <div class="glass-card rounded-2xl overflow-hidden slide-up">
            <div class="overflow-x-auto">
                <table class="min-w-full">
                    <thead class="bg-gradient-to-r from-gray-50 to-gray-100">
                        <tr>
                            <th class="px-6 py-4 text-left text-sm font-bold text-gray-700 uppercase tracking-wider">
                                <i class="fas fa-barcode mr-2"></i>Mã đơn
                            </th>
                            <th class="px-6 py-4 text-left text-sm font-bold text-gray-700 uppercase tracking-wider">
                                <i class="fas fa-user mr-2"></i>Khách hàng
                            </th>
                            <th class="px-6 py-4 text-left text-sm font-bold text-gray-700 uppercase tracking-wider">
                                <i class="fas fa-box mr-2"></i>Sản phẩm đã mua
                            </th>
                            <th class="px-6 py-4 text-left text-sm font-bold text-gray-700 uppercase tracking-wider">
                                <i class="fas fa-calendar mr-2"></i>Ngày đặt
                            </th>
                            <th class="px-6 py-4 text-right text-sm font-bold text-gray-700 uppercase tracking-wider">
                                <i class="fas fa-money-bill-wave mr-2"></i>Tổng tiền
                            </th>
                            <th class="px-6 py-4 text-left text-sm font-bold text-gray-700 uppercase tracking-wider">
                                <i class="fas fa-info-circle mr-2"></i>Trạng thái
                            </th>
                            <th class="px-6 py-4 text-center text-sm font-bold text-gray-700 uppercase tracking-wider">
                                <i class="fas fa-cogs mr-2"></i>Hành động
                            </th>
                        </tr>
                    </thead>
                    <tbody id="orderTable" class="bg-white divide-y divide-gray-100">
                        <!-- Loading state -->
                        <tr id="loadingRow">
                            <td colspan="7" class="px-6 py-12 text-center">
                                <div class="flex justify-center items-center space-x-3">
                                    <div class="loading-spinner"></div>
                                    <span class="text-gray-500">Đang tải dữ liệu...</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div id="pagination" class="mt-4 flex justify-center space-x-2"></div>
    </div>

    <!-- Modal thay đổi trạng thái -->
<div id="statusModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-40 hidden">
  <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-md relative" style="max-height:80vh; overflow-y:auto;">
    <button id="closeStatusModal" class="absolute top-3 right-4 text-gray-400 hover:text-red-500 text-xl">
      <i class="fas fa-times"></i>
    </button>
    <h2 class="text-xl font-bold mb-4">Thay đổi trạng thái</h2>
    <div id="statusOptions" class="space-y-2"></div>
    <div class="mt-4 text-right">
      <button id="confirmStatusBtn" class="btn-primary px-4 py-2">Cập nhật</button>
    </div>
  </div>
</div>

    <!-- Modal xem chi tiết đơn hàng -->
<div id="viewOrderModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-40 hidden">
  <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-2xl relative" style="max-height:80vh; overflow-y:auto;">
    <button id="closeViewModal" class="absolute top-3 right-4 text-gray-400 hover:text-red-500 text-xl">
      <i class="fas fa-times"></i>
    </button>
    <div id="viewOrderContent">
      <div class="text-center text-gray-400 py-8">Đang tải...</div>
    </div>
  </div>
</div>

    <!-- Modal xem chi tiết đơn hàng -->
<div id="viewOrderModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-40 hidden">
  <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-2xl relative" style="max-height:80vh; overflow-y:auto;">
    <button id="closeViewModal" class="absolute top-3 right-4 text-gray-400 hover:text-red-500 text-xl">
      <i class="fas fa-times"></i>
    </button>
    <div id="viewOrderContent">
      <div class="text-center text-gray-400 py-8">Đang tải...</div>
    </div>
  </div>
</div>

    <script>
        // Move modals to body to prevent transform issues
        const statusModalEl = document.getElementById('statusModal');
        if (statusModalEl && statusModalEl.parentNode !== document.body) {
            document.body.appendChild(statusModalEl);
        }
        const viewOrderModalEl = document.getElementById('viewOrderModal');
        if (viewOrderModalEl && viewOrderModalEl.parentNode !== document.body) {
            document.body.appendChild(viewOrderModalEl);
        }
        let currentStatus = '';
        let currentOrders = [];
        let isLoading = false;
        let currentPage = 1;
        let totalPages = 1;
        let statusTabs = [];
        let changingOrderId = null;

        async function fetchStatusTabs() {
            const res = await fetch('/orders/status-tabs');
            return await res.json();
        }

        const LIMIT = 10;
        async function fetchOrders(status = '', query = '', page = 1) {
            setLoading(true);
            let url = '/orders?';
            if (status) url += `status=${encodeURIComponent(status)}&`;
            if (query) url += `q=${encodeURIComponent(query)}&`;
            url += `page=${page}&limit=${LIMIT}`;
            const res = await fetch(url);
            const data = await res.json();
            currentOrders = data.data;
            totalPages = data.totalPages;
            currentPage = data.page;
            const countEl = document.getElementById('orderCount');
            if (countEl && typeof data.total === 'number') {
                countEl.textContent = data.total;
            }
            setLoading(false);
            return data;
        }

        function setLoading(loading) {
            isLoading = loading;
            const loadingRow = document.getElementById('loadingRow');
            if (loading) {
                loadingRow.style.display = 'table-row';
            } else {
                loadingRow.style.display = 'none';
            }
        }

        function getStatusIcon(status) {
            const icons = {
                pending: 'fas fa-clock',
                packed: 'fas fa-box',
                shipping: 'fas fa-truck',
                delivered: 'fas fa-check-double',
                return_requested: 'fas fa-undo-alt',
                cancelled: 'fas fa-times-circle'
            };
            return icons[status] || 'fas fa-question-circle';
        }

        function getStatusText(status) {
            const texts = {
                pending: 'Chờ xác nhận',
                packed: 'Chờ lấy hàng',
                shipping: 'Chờ giao hàng',
                delivered: 'Đã giao',
                return_requested: 'Trả hàng',
                cancelled: 'Đã huỷ'
            };
            return texts[status] || status;
        }

        function renderStatusOptions(tabs) {
            const select = document.getElementById('statusFilter');
            select.innerHTML = '<option value="">Tất cả trạng thái</option>';
            tabs.forEach(tab => {
                const opt = document.createElement('option');
                opt.value = tab.key;
                opt.textContent = tab.label;
                if (tab.key === currentStatus) opt.selected = true;
                select.appendChild(opt);
            });
        }

        function renderOrders(orders) {
            const tbody = document.getElementById('orderTable');
            // Clear existing rows except loading row
            const rows = tbody.querySelectorAll('tr:not(#loadingRow)');
            rows.forEach(row => row.remove());

            if (orders.length === 0 && !isLoading) {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td colspan="7" class="px-6 py-12 text-center">
                        <div class="flex flex-col items-center space-y-4">
                            <i class="fas fa-inbox text-gray-300 text-6xl"></i>
                            <p class="text-gray-500 text-lg">Không tìm thấy đơn hàng nào</p>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
                return;
            }

            orders.forEach((order, index) => {
                const name = order.user_id?.full_name || '—';
                const date = order.order_date ? new Date(order.order_date).toLocaleDateString('vi-VN') : '';
                const total = new Intl.NumberFormat('vi-VN', {
                    style: 'currency',
                    currency: 'VND'
                }).format(order.total);

                // Tổng số lượng sản phẩm trong đơn
                let productsHtml = '';
                if (Array.isArray(order.products)) {
                    const totalQty = order.products.reduce((sum, p) => sum + (p.quantity || 0), 0);
                    productsHtml = `<div><strong>${totalQty}</strong> sản phẩm</div>`;
                }

                const tr = document.createElement('tr');
                tr.className = 'table-row fade-in';
                tr.style.animationDelay = `${index * 0.1}s`;

                tr.innerHTML = `
                    <td class="px-6 py-4 whitespace-nowrap" data-label="Mã đơn">
                        <div class="flex items-center">
                            <div class="w-2 h-2 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full mr-3"></div>
                            <span class="text-sm font-mono text-gray-900">${order._id}</span>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap" data-label="Khách hàng">
                        <div class="flex items-center">
                            <div class="w-8 h-8 bg-gradient-to-r from-blue-500 to-purple-500 rounded-full flex items-center justify-center mr-3">
                                <i class="fas fa-user text-white text-xs"></i>
                            </div>
                            <span class="text-sm font-medium text-gray-900">${name}</span>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap" data-label="Sản phẩm đã mua">
                        <div class="order-products-list">${productsHtml}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap" data-label="Ngày đặt">
                        <div class="flex items-center">
                            <i class="fas fa-calendar-day text-gray-400 mr-2"></i>
                            <span class="text-sm text-gray-500">${date}</span>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right" data-label="Tổng tiền">
                        <span class="text-sm font-bold text-gray-900">${total}</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap" data-label="Trạng thái">
                        <span class="status-${order.status} status-icon inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold">
                            <i class="${getStatusIcon(order.status)} mr-1"></i>
                            ${getStatusText(order.status)}
                        </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-center" data-label="Hành động">
                        <div class="flex justify-center space-x-2">
                            <button onclick="viewOrder('${order._id}')" class="btn-secondary text-white px-3 py-2 rounded-lg text-sm font-medium shadow-md icon-bounce">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button onclick="changeStatus('${order._id}', '${order.status}')" class="btn-danger text-white px-3 py-2 rounded-lg text-sm font-medium shadow-md icon-bounce">
                                <i class="fas fa-sync-alt"></i>
                            </button>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });
            renderPagination(totalPages);
        }

        function renderPagination(total) {
            const container = document.getElementById('pagination');
            container.innerHTML = '';
            if (total <= 1) return;
            for (let i = 1; i <= total; i++) {
                const btn = document.createElement('button');
                btn.textContent = i;
                btn.className = `px-3 py-1 rounded text-sm ${i === currentPage ? 'bg-purple-500 text-white' : 'bg-white text-purple-500 border border-purple-500'}`;
                btn.onclick = async () => {
                    if (i === currentPage) return;
                    currentPage = i;
                    await fetchOrders(currentStatus, document.getElementById('searchInput').value.trim(), currentPage);
                    renderOrders(currentOrders);
                };
                container.appendChild(btn);
            }
        }

        async function viewOrder(id) {
            const modal = document.getElementById('viewOrderModal');
            const container = document.getElementById('viewOrderContent');
            modal.classList.remove('hidden');
            container.innerHTML = '<div class="text-center text-gray-400 py-8">Đang tải...</div>';
            try {
                const res = await fetch(`/orders/${id}`);
                const order = await res.json();
                const total = new Intl.NumberFormat('vi-VN', {
                    style: 'currency',
                    currency: 'VND'
                }).format(order.total || 0);
                let productsHtml = '';
                if (Array.isArray(order.products)) {
                    productsHtml = order.products.map(p => {
                        const img = p.productId?.image || 'https://via.placeholder.com/80';
                        const name = p.productId?.name || '';
                        const variant = p.variant?.label || '';
                        const qty = p.quantity || 0;
                        const price = new Intl.NumberFormat('vi-VN', {
                            style: 'currency',
                            currency: 'VND'
                        }).format((p.productId?.price || 0) + (p.variant?.priceDiff || 0));
                        return `<div class="flex items-center mb-4">
                                    <img src="${img}" class="w-16 h-16 object-cover rounded mr-4" alt="${name}">
                                    <div class="flex-1">
                                        <div class="font-medium">${name}</div>
                                        <div class="text-sm text-gray-500">${variant}</div>
                                    </div>
                                    <div class="text-sm text-gray-500 mr-4">x${qty}</div>
                                    <div class="font-semibold">${price}</div>
                                </div>`;
                    }).join('');
                }
                const receiverName = order.user_id?.full_name || '';
                const receiverPhone = order.user_id?.phone || '';
                const receiverAddress = order.address || '';
                container.innerHTML = `
                    <h2 class="text-xl font-bold mb-4">Đơn hàng #${order._id}</h2>
                    <div class="mb-4">
                        <div class="mb-2"><strong>Người nhận:</strong> ${receiverName}</div>
                        <div class="mb-2"><strong>SĐT:</strong> ${receiverPhone}</div>
                        <div class="mb-2"><strong>Địa chỉ:</strong> ${receiverAddress}</div>
                        <div class="mb-2"><strong>Phương thức thanh toán:</strong> ${order.paymentMethod || ''}</div>
                        <div class="mb-2"><strong>Tổng giá trị:</strong> ${total}</div>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold mb-2">Sản phẩm</h3>
                        ${productsHtml}
                    </div>
                `;
            } catch (err) {
                container.innerHTML = '<div class="text-center text-red-500 py-8">Không thể tải chi tiết đơn hàng</div>';
            }
        }

        function changeStatus(id, current) {
            changingOrderId = id;
            const modal = document.getElementById('statusModal');
            const container = document.getElementById('statusOptions');
            container.innerHTML = statusTabs.map(tab => `
                <label class="flex items-center space-x-2">
                    <input type="radio" name="status" value="${tab.key}" ${tab.key === current ? 'checked' : ''}>
                    <span>${tab.label}</span>
                </label>
            `).join('');
            modal.classList.remove('hidden');
        }

        const statusModal = document.getElementById('statusModal');
        const viewModal = document.getElementById('viewOrderModal');

        document.getElementById('closeStatusModal').addEventListener('click', () => {
            statusModal.classList.add('hidden');
        });
        document.getElementById('closeViewModal').addEventListener('click', () => {
            viewModal.classList.add('hidden');
        });
        document.getElementById('closeViewModal').addEventListener('click', () => {
            viewModal.classList.add('hidden');
        });

        statusModal.addEventListener('click', (e) => {
            if (e.target === statusModal) statusModal.classList.add('hidden');
        });
        viewModal.addEventListener('click', (e) => {
            if (e.target === viewModal) viewModal.classList.add('hidden');
        });
        viewModal.addEventListener('click', (e) => {
            if (e.target === viewModal) viewModal.classList.add('hidden');
        });

        document.getElementById('confirmStatusBtn').addEventListener('click', async () => {
            const selected = document.querySelector('#statusOptions input[name="status"]:checked');
            if (!selected || !changingOrderId) return;
            const res = await fetch(`/orders/${changingOrderId}/status`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: selected.value })
            });
            if (res.ok) {
                showNotification('Cập nhật trạng thái thành công!', 'success');
                statusModal.classList.add('hidden');
                await fetchOrders(currentStatus, document.getElementById('searchInput').value.trim(), currentPage);
                renderOrders(currentOrders);
            } else {
                showNotification('Có lỗi khi cập nhật trạng thái!', 'error');
            }
        });

        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.className = `fixed top-4 right-4 z-50 px-6 py-4 rounded-xl shadow-lg transition-all duration-300 transform translate-x-full`;

            if (type === 'success') {
                notification.className += ' bg-green-500 text-white';
            } else if (type === 'error') {
                notification.className += ' bg-red-500 text-white';
            } else {
                notification.className += ' bg-blue-500 text-white';
            }

            notification.innerHTML = `
                <div class="flex items-center">
                    <i class="fas fa-check-circle mr-2"></i>
                    <span>${message}</span>
                </div>
            `;

            document.body.appendChild(notification);

            setTimeout(() => {
                notification.classList.remove('translate-x-full');
            }, 100);

            setTimeout(() => {
                notification.classList.add('translate-x-full');
                setTimeout(() => {
                    document.body.removeChild(notification);
                }, 300);
            }, 3000);
        }

        document.addEventListener('DOMContentLoaded', async () => {
            statusTabs = await fetchStatusTabs();
            renderStatusOptions(statusTabs);
            await fetchOrders();
            renderOrders(currentOrders);

            document.getElementById('searchInput').addEventListener('input', async (e) => {
                const query = e.target.value.trim();
                await fetchOrders(currentStatus, query, 1);
                renderOrders(currentOrders);
            });

            document.getElementById('statusFilter').addEventListener('change', async (e) => {
                currentStatus = e.target.value;
                await fetchOrders(currentStatus, document.getElementById('searchInput').value.trim(), 1);
                renderOrders(currentOrders);
            });
        });
    </script>